{
  "family": "orcapath",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::381374795947:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::381374795947:role/orcapathTaskRole",
  "containerDefinitions": [
    {
      "name": "orcapath",
      "image": "381374795947.dkr.ecr.ca-central-1.amazonaws.com/orcapath:1.0.0",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ca-central-1:381374795947:secret:orcapath/prod/database-url-KuNWJW"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/orcapath",
          "awslogs-region": "ca-central-1",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}